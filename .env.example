# Keep this file on the backend. Never commit your real .env.
ELEVENLABS_API_KEY=
ELEVENLABS_AUTO_VOICE_ID=21m00Tcm4TlvDq8ikWAM

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Official Google Gemini API / AI Studio credentials (not Vertex AI).
GEMINI_API_KEY=
GEMINI_API_MODE=interactions
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
VEO_MODEL=veo-3.1-generate-preview

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Fine-grained PAT for your selected repository: Contents read/write.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PROJECTS_PATH=ai-video-studio

# Account cookies: true after deploying behind HTTPS.
COOKIE_SECURE=false
# Leave blank to use the generated local session secret.
APP_SECRET_KEY=
TELEGRAM_SUPPORT_USERNAME=Grow3833
# No sales until price is configured (VND / 30 days).
PRO_PRICE_VND=0
PRO_BANK_NAME=
PRO_BANK_ACCOUNT=
PRO_BANK_HOLDER=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Public HTTPS origin used for PayOS redirect/webhook registration.
PUBLIC_BASE_URL=

# Runtime data can move to a persistent disk without changing code.
STUDIO_DATA_ROOT=
# OpenAI-compatible text server, e.g. a vLLM/Ollama endpoint you deploy.
# Use the exact base URL and model from your server; no default live server.
SELF_HOSTED_BASE_URL=
SELF_HOSTED_MODEL=
SELF_HOSTED_API_KEY=
SELF_HOSTED_MAX_TOKENS=8000
# Local development only. Docker Compose overrides this to false.
ENABLE_KILO_BRIDGE=true
